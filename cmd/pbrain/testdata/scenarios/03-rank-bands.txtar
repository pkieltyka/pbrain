# Functional spec §15, scenario 3.
pbrain init
pbrain-test search clock --json
ids results fresh verified sameband undated
pbrain-test search locations --json
ids results titled bodyonly
pbrain-test search '"job queue"' --json
ids results phrase reversed
pbrain-test search clock
stdout '^undated  note  provisional  unknown'

