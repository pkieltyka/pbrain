# Functional spec §15, scenario 23. The skill also works without a brain.
pbrain skill
stdout 'pbrain skill import'
cp stdout $WORK/core
exec sh -c 'test "$(wc -w < "$1")" -le 400' sh $WORK/core
pbrain skill --help
stdout '^Usage: pbrain skill'
stdout '^  --json '
stdout '^  --help '
stdout '^  --version '
! stdout '^  --(brain|personal) '
pbrain --brain missing --personal skill
cmp stdout $WORK/core
pbrain skill list
cmp stdout $WORK/topics
pbrain skill import
cp stdout $WORK/import
pbrain skill claude-artifacts
cp stdout $WORK/claude-artifacts
pbrain skill google-docs
cp stdout $WORK/google-docs
pbrain skill browser-use
cp stdout $WORK/browser-use
pbrain skill semantic
cp stdout $WORK/semantic
exec sh -c 'for topic do test -s "$topic" && test "$(wc -w < "$topic")" -le 300 || exit 1; done' sh $WORK/import $WORK/claude-artifacts $WORK/google-docs $WORK/browser-use $WORK/semantic

-- topics --
import
claude-artifacts
google-docs
browser-use
semantic
