# Functional spec §15, scenario 12.
pbrain init
pbrain get X --history --json
ids history X
pbrain list --json
stdout '"id":"X"'
stdout '"id":"Y"'
pbrain get A --json
stdout '"replacement":\["B","C"\]'
pbrain search fork --all
stdout 'replacement: B, C'
status 1 pbrain check --json
stdout 'replace_fork'
cp $WORK/D docs/brain/D.md
pbrain get A --json
stdout '"current":\["C","D"\]'
status 1 pbrain check --json
stdout 'replace_fork'
cp $WORK/E docs/brain/E.md
pbrain get A --json
stdout '"current":\["E"\]'
pbrain get E --history --json
ids history A B C D E
status 1 pbrain check --json
! stdout 'replace_fork'

