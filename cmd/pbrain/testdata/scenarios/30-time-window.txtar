# Functional spec §15, scenario 30.
pbrain init
pbrain-test search windowword --limit 1
stdout '^old  decision'
pbrain-test search windowword --since 7d --json
ids results recent
stdout '"outside_window":2'
pbrain-test search older-only --since 7d --json
ids results
stdout '"outside_window":1'
pbrain-test list --tag oldonly --since 7d --json
ids results
stdout '"outside_window":1'
pbrain-test search recent-only --until 2026-11-19
stdout '--until'
env TZ=America/Toronto
pbrain-test search midnightword --since today --json
ids results after-midnight
stdout '"outside_window":1'
env TZ=UTC
pbrain-test search midnightword --since today --json
ids results after-midnight before-midnight
env TZ=America/Toronto
pbrain-test search endword --since 2026-11-19 --until 2026-11-19 --json
ids results end-of-day
pbrain-test search endword --until 2026-11-19 --json
ids results end-of-day
env PBRAIN_TEST_NOW=2026-11-01T15:00:00Z
pbrain-test search dstword --since today --json
ids results dst-after
status 2 pbrain-test search windowword --since soon --json
stderr '"code":"usage"'
status 2 pbrain-test search windowword --since 3x --json
stderr '"code":"usage"'
status 2 pbrain-test search windowword --since 2026-11-20 --until 2026-11-19 --json
stderr '"code":"usage"'

