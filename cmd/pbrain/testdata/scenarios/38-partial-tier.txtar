# Functional spec §15, scenario 38: the partial tier. 25 items; "system" is held by more than a
# quarter of them. Every title but one carries "alpha", a test-model keyword, so a keyword-free
# query can match only the item "Meaning only" by meaning.
pbrain init

# A release that holds the tier back rejects --bm25 as a usage error.
env PBRAIN_TEST_BM25=off
status 2 pbrain-test search queue retry timeout backoff worker lease --bm25
env PBRAIN_TEST_BM25=

# No item holds all six words: nothing without the flag; with it the items holding five, the higher
# BM25 score first, never an item holding four.
pbrain-test search queue retry timeout backoff worker lease
stdout '^0 results\. Alone: '
pbrain-test search queue retry timeout backoff worker lease --bm25
stdout '^20261101-000000-p1-p1p1  note  provisional  2026-11-01  partial 5/6$'
stdout '^20261101-000000-p2-p2p2  note  provisional  2026-11-01  partial 5/6$'
! stdout 'f4-f4f4'
pbrain-test search queue retry timeout backoff worker lease --bm25 --json
ids results 20261101-000000-p1-p1p1 20261101-000000-gap-g1g1 20261101-000000-p2-p2p2
stdout '"clauses":6,.*"id":"20261101-000000-p1-p1p1",.*"matched":5,.*"partial":true'

# A word given both bare and quoted counts as one clause, and quoted it is required: the item
# without it drops out.
pbrain-test search queue '"queue"' retry timeout backoff worker lease --bm25 --json
ids results 20261101-000000-p1-p1p1 20261101-000000-gap-g1g1
stdout '"clauses":6,'
! stdout '"clauses":7'

# A phrase or a prefix the item does not match keeps it out. The item holds "green red", not the
# phrase "red green", and no word starting "gol".
pbrain-test search red green blue cyan teal pink gold --bm25 --json
ids results 20261101-000000-colours-k1k1
stdout '"clauses":7,.*"matched":6,'
pbrain-test search '"red green"' blue cyan teal pink gold --bm25 --json
ids results
pbrain-test search red green blue cyan teal pink 'gol*' --bm25 --json
ids results
pbrain-test search red green blue cyan teal 'pin*' gold --bm25 --json
ids results 20261101-000000-colours-k1k1

# A word held by more than a quarter of the items does not count towards the five informative clauses.
pbrain-test search system queue retry timeout backoff worker --bm25 --json
ids results 20261101-000000-p1-p1p1
! stdout 'c5-c5c5'

# Five clauses or fewer: no partial result.
pbrain-test search queue retry timeout backoff zebra --bm25 --json
ids results

# A question sharing only common words with the fixture: 0 results, with its per-clause counts.
pbrain-test search the system and the words of a volcano --bm25
stdout '^0 results\. Alone: '

# Paging at a page size of one visits each result once.
pbrain-test search queue retry timeout backoff worker lease --bm25 --limit 1 --json
ids results 20261101-000000-p1-p1p1
pbrain-test search queue retry timeout backoff worker lease --bm25 --limit 1 --offset 1 --json
ids results 20261101-000000-gap-g1g1
pbrain-test search queue retry timeout backoff worker lease --bm25 --limit 1 --offset 2 --json
ids results 20261101-000000-p2-p2p2
pbrain-test search queue retry timeout backoff worker lease --bm25 --limit 1 --offset 3 --json
ids results

# Without --personal the output is identical before and after a personal item with the same words.
pbrain-test search queue retry timeout backoff worker lease --bm25
cp stdout $WORK/shared-before
mkdir docs/brain/personal
cp $WORK/mine.md docs/brain/personal/mine.md
pbrain-test search queue retry timeout backoff worker lease --bm25
cmp stdout $WORK/shared-before

# No index, model or cache is read or written.
countfiles $PBRAIN_CACHE 0
countfiles docs/brain/.pbrain 0

# An item written with add that qualifies appears in the next search, with no other step: this one
# holds all six, so it is exact, and the partial results follow it unchanged.
cp $WORK/old.md docs/brain/notes/20261001-000000-old-o1o1.md
pbrain-test add --title 'Alpha all six' --body 'queue retry timeout backoff worker lease' --replaces 20261001-000000-old-o1o1
pbrain-test search queue retry timeout backoff worker lease
cp stdout $WORK/exact.txt
stdout '^1 result\. 1 replaced item also matched: --all\.$'
pbrain-test search queue retry timeout backoff worker lease --bm25
cp stdout $WORK/both.txt
sameprefix $WORK/exact.txt $WORK/both.txt
stdout '^4 results\. 1 replaced item also matched: --all\.$'

# A single quoted word the item does not hold keeps it out.
pbrain-test search durable queue retry timeout backoff worker lease --bm25 --json
stdout '"id":"2026112[0-9]-[0-9]{6}-alpha-all-six-[a-z0-9]{4}"'
pbrain-test search '"durable"' queue retry timeout backoff worker lease --bm25 --json
! stdout 'alpha-all-six'

# The replaced and outside-window counts are the same with and without the flag.
pbrain-test search queue retry timeout backoff worker lease --until 2026-11-10
stdout ' 1 replaced item also matched: --all\. 1 match outside the time window: drop --until\.'
pbrain-test search queue retry timeout backoff worker lease --until 2026-11-10 --bm25
stdout ' 1 replaced item also matched: --all\. 1 match outside the time window: drop --until\.'

# With --semantic as well: exact, then found by meaning, then partial, no item twice; with the model
# absent, exact and partial come with semantic_not_ready.
testmodel test-model $WORK/table.json
pbrain-test index
pbrain-test search queue retry timeout backoff worker lease --bm25 --semantic
stdout -count=1 '^2026112[0-9]-[0-9]{6}-alpha-all-six-'
stdout '^20261101-000000-mean-m1m1  note  provisional  2026-11-01  semantic$'
pbrain-test search queue retry timeout backoff worker lease --bm25 --semantic --json
stdout '"id":"2026112[0-9]-[0-9]{6}-alpha-all-six-[a-z0-9]{4}".*"id":"20261101-000000-mean-m1m1".*"id":"20261101-000000-p1-p1p1"'
rm docs/brain/personal.toml
pbrain-test search queue retry timeout backoff worker lease --bm25 --semantic
stderr '^semantic_not_ready: the model is not on this machine'
stdout '^4 results\. 1 replaced item also matched: --all\.$'

# In a brain of three items no query has a partial result.
mkdir $WORK/small
cd $WORK/small
exec git init -q .
pbrain init
cp $WORK/three-a.md docs/brain/a.md
cp $WORK/three-b.md docs/brain/b.md
cp $WORK/three-c.md docs/brain/c.md
pbrain-test search queue retry timeout backoff worker lease --bm25
stdout '^0 results\.'

-- table.json --
{"alpha":[1,0,0,0,0,0,0,0],"beta":[0,1,0,0,0,0,0,0],"gamma":[0,0,1,0,0,0,0,0],"delta":[0,0,0,1,0,0,0,0],"session":[0,0,0,0,1,0,0,0],"login":[0,0,0,0,1,0,0,0],"orbit":[0,0,0,0,0,1,0,0],"volcano":[0,0,0,0,0,0,1,0]}
