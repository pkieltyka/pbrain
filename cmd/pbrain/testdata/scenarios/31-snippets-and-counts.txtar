# Functional spec §15, scenario 31: snippets, positions and per-clause counts.
mkdir docs/brain/personal
pbrain init

# A long source has queue on its first line and queue with rollback far in: the later passage is the
# snippet, with its location line in text, its fields in JSON, and its section.
pbrain-test search queue rollback
stdout '^guide  source  provisional  2026-11-01$'
stdout '^  docs/brain/guide.md:188  \[body L8, offset 7669/7899; file 194L/7991C; 3 occurrences\] \[in Section 58\]$'
stdout '## Recovery  When the queue stalls, a rollback…$'
fileline docs/brain/guide.md 188 'ordinary prose about other things$'
pbrain-test search queue rollback --json
stdout '"section":"Section 58","snippet":"…rose about other things ## Section 59 .*a rollback…","snippet_line":188,"snippet_offset":7669'
pbrain-test get guide --offset 7669 --max-chars 600
stdout '^rose about other things$'
stdout '^When the queue stalls, a rollback restores the previous state\.$'
stdout '^\[body 7669 to .*; file L188–'

# A short learning has a location line too, offset 0 where its passage starts the body, and names no
# section.
pbrain-test search queue rollback
stdout '^  docs/brain/learn.md:8  \[body L8, offset 0/29; file 8L/121C; 3 occurrences\]$'

# A phrase counts as one clause when passages are compared: the passage holding it is chosen.
pbrain-test search '"queue stalls"' rollback
stdout '^  docs/brain/guide.md:188  \[body L8, offset 7669/7899; file 194L/7991C; 2 occurrences\] \[in Section 58\]$'

# A wrapped paragraph with multibyte characters before the hit: the printed position opens get on
# the same passage.
pbrain-test search marmot
stdout '^  docs/brain/wrap.md:10  \[body L8, offset 137/370; file 15L/461C; 1 occurrence\]$'
stdout '^  …ñ characters in prose wrapped line 3'
pbrain-test get wrap --offset 137
stdout '^ñ characters in prose$'
stdout '^\[body 137 to 369 of 370; file L10–L15\]$'

# An empty result counts each clause, in text and JSON, within the view and the filters.
pbrain-test search nothinghere personalonlyword
stdout '^0 results\. Alone: nothinghere 0, personalonlyword 0\.$'
pbrain-test search nothinghere personalonlyword --json
stdout '^\{"alone":\[\{"clause":"nothinghere","count":0\},\{"clause":"personalonlyword","count":0\}\]\}$'
pbrain-test search nothinghere personalonlyword --personal
stdout '^0 results\. Alone: nothinghere 0, personalonlyword 1\.$'
pbrain-test search nothinghere queue --kind decision
stdout '^0 results\. Alone: nothinghere 0, queue 0\.$'

# A page that has results, and an offset past the end of them, print no counts.
pbrain-test search queue
! stdout 'Alone'
pbrain-test search queue --offset 9
stdout '^0 results\.$'
pbrain-test search queue --offset 9 --json
! stdout 'alone'

# With nine short clauses, and with one quoted phrase longer than the whole limit, the empty result
# still succeeds: the closing parts and an outside-window count stay, and only the count entries that
# fit are shown.
pbrain-test search nothinghere a b c d e f g h --max-chars 60
stdout '^0 results\. Alone: nothinghere 0, a [0-9]+, b 0, c 0, d 0, e 0\.$'
pbrain-test search '"longphrase longphrase longphrase longphrase longphrase longphrase longphrase longphrase longphrase longphrase longphrase longphrase longphrase longphrase longphrase longphrase longphrase longphrase longphrase longphrase longphrase longphrase longphrase longphrase longphrase longphrase longphrase longphrase longphrase longphrase"' --since 7d --max-chars 80
stdout '^0 results\. 0 matches outside the time window: drop --since\.$'
! stdout 'Alone'

-- repo/docs/brain/guide.md --
