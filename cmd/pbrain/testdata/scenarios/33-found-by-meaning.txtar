# Functional spec §15, scenario 33: found by meaning. The test model's table makes "session" and
# "login" one direction, so the question shares no word with the decision it finds.
pbrain init
testmodel test-model $WORK/table.json
pbrain-test sync
stdout '^shared: 4 items indexed, 0 items removed; 104 passages embedded, 0 reused$'
countfiles $PBRAIN_CACHE/vectors 104

# Without --semantic the question finds nothing, with its per-clause counts.
pbrain-test search where is login state kept
stdout '^0 results\. Alone: where 0, is [0-9]+, login 0, state 0, kept 0\.$'

# With it the decision is returned, marked semantic, with a snippet from its closest passage; for the
# long source the snippet carries its position and section, and get --offset opens on it.
pbrain-test search where is login state kept --semantic
stdout '^20261101-000000-sessions-redis-s1s1  decision  verified  2026-11-01  semantic$'
stdout '^  docs/brain/decisions/20261101-000000-sessions-redis-s1s1.md:11  \[body L11, offset 0/57; file 11L/233C; 0 occurrences\]$'
stdout '^20261102-000000-guide-g1g1  source  provisional  2026-11-02  semantic$'
stdout '^  docs/brain/sources/20261102-000000-guide-g1g1.md:310  \[body L8, offset 7389/7453; file 312L/7542C; 1 occurrence\] \[in Auth\]$'
stdout '^  …## Auth  Each session token is stored server side in the cache\. $'
pbrain-test search where is login state kept --semantic --json
stdout '"id":"20261101-000000-sessions-redis-s1s1",.*"semantic":true'
stdout '"section":"Auth","semantic":true,"snippet":"…## Auth .*","snippet_line":310,"snippet_offset":7389'
pbrain-test get 20261102-000000-guide-g1g1 --offset 7389 --max-chars 400
stdout '^## Auth$'
stdout '^\[body 7389 to 7452 of 7453; file L310–L312\]$'

# A query with lexical results keeps them, in order, with the same lines; the added results follow
# and no item is listed twice.
pbrain-test search sessions
cp stdout $WORK/plain.txt
pbrain-test search sessions --semantic
cp stdout $WORK/semantic.txt
sameprefix $WORK/plain.txt $WORK/semantic.txt
stdout -count=1 '^20261101-000000-sessions-redis-s1s1  '
stdout '^20261102-000000-guide-g1g1  source  provisional  2026-11-02  semantic$'
stdout '^2 results\.$'
pbrain-test search sessions --semantic --json
ids results 20261101-000000-sessions-redis-s1s1 20261102-000000-guide-g1g1

# At the exact minimum of the search without the flag, the flag fails with budget_too_small; the
# minimum it states returns the lexical result unchanged, with more and next. Text and JSON.
! pbrain-test search sessions --max-chars 1
minbudget PLAIN
pbrain-test search sessions --max-chars $PLAIN
cp stdout $WORK/plain-min.txt
! pbrain-test search sessions --semantic --max-chars $PLAIN
stderr '^budget_too_small: '
minbudget WITH
pbrain-test search sessions --semantic --max-chars $WITH
sameprefix $WORK/plain-min.txt stdout
stdout '^1 result\. 1 more: --offset 1\.$'
! pbrain-test search sessions --json --max-chars 1
minbudget PLAINJ
! pbrain-test search sessions --semantic --json --max-chars $PLAINJ
minbudget WITHJ
pbrain-test search sessions --semantic --json --max-chars $WITHJ
ids results 20261101-000000-sessions-redis-s1s1
stdout '"more":1,"next":1'

# Paging at a page size of one visits each result of the whole list once.
pbrain-test search sessions --semantic --limit 1 --json
ids results 20261101-000000-sessions-redis-s1s1
pbrain-test search sessions --semantic --limit 1 --offset 1 --json
ids results 20261102-000000-guide-g1g1
pbrain-test search sessions --semantic --limit 1 --offset 2 --json
ids results

# An added result is never a replaced item without --all, never outside the time window and never
# of a kind --kind excludes.
pbrain-test search where is login state kept --semantic
! stdout '20261001-000000-old-auth-o1o1'
pbrain-test search where is login state kept --semantic --all
stdout '^20261001-000000-old-auth-o1o1  decision  verified  2026-10-01  semantic  replaced$'
pbrain-test search where is login state kept --semantic --since 7d
stdout '^0 results\. 0 matches outside the time window: drop --since\.'
pbrain-test search where is login state kept --semantic --kind note
stdout '^0 results\.'

# Without --personal no personal item is added; after index --personal neither the shared index nor
# the per-user cache holds a vector of one.
pbrain-test search where is login state kept --semantic
! stdout 'mine-p1p1'
pbrain-test sync --personal
stdout '^personal: 1 item indexed, 0 items removed; 1 passage embedded, 0 reused$'
countfiles $PBRAIN_CACHE/vectors 104
tree-absent docs/brain/.pbrain 'login reminders'
pbrain-test sync --status
stdout '^shared: 4 of 4 items indexed$'
pbrain-test search where is login state kept --semantic
! stdout 'mine-p1p1'
pbrain-test search where is login state kept --semantic --personal
stdout '^20261104-000000-mine-p1p1  note  provisional  2026-11-04  semantic  personal$'

-- table.json --
{"alpha":[1,0,0,0,0,0,0,0],"beta":[0,1,0,0,0,0,0,0],"gamma":[0,0,1,0,0,0,0,0],"delta":[0,0,0,1,0,0,0,0],"session":[0,0,0,0,1,0,0,0],"login":[0,0,0,0,1,0,0,0],"orbit":[0,0,0,0,0,1,0,0],"volcano":[0,0,0,0,0,0,1,0]}
-- repo/docs/brain/decisions/20261101-000000-sessions-redis-s1s1.md --
