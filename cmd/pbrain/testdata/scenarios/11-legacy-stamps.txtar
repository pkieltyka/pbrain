# Functional spec §15, scenario 11.
pbrain init
pbrain get old --json
stdout '"replacement":\["successor"\]'
pbrain get missing --json
! stdout '"replacement"'
pbrain get both --json
stdout '"replacement":\["real"\]'
pbrain get cycle-old --history --json
ids history cycle-old cycle-new
pbrain get cycle-new --json
! stdout '"replacement"'
pbrain list --json
! stdout '"id":"old"'
stdout '"id":"missing"'

