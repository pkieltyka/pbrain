+func q6EvalLongFixture(t *testing.T) []string {
+	t.Helper()
+	var fixture struct {
+		Source string
+		Notes  []string
+	}
+	data, err := os.ReadFile(os.Getenv("PBRAIN_Q6_EVAL_219"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := json.Unmarshal(data, &fixture); err != nil {
+		t.Fatal(err)
+	}
+	var texts []string
+	for _, path := range fixture.Notes {
+		data, err := os.ReadFile(filepath.Join(fixture.Source, path))
+		if err != nil {
+			t.Fatal(err)
+		}
+		h, off, _, err := item.Parse(path, data)
+		if err != nil {
+			t.Fatal(err)
+		}
+		for _, p := range semantic.Passages(h.Title, data[off:]) {
+			texts = append(texts, p.Text)
+		}
+	}
+	if len(fixture.Notes) != 22 || len(texts) != 219 {
+		t.Fatalf("unexpected fixture %d/%d", len(fixture.Notes), len(texts))
+	}
+	return texts
