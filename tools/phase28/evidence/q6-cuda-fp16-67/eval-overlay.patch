+// verifyEvalCUDAAttach reads the v0.6.7 handle's initialized pipeline
+// flags. The public handle reports only the backend name and the device.
+func verifyEvalCUDAAttach(acc embeddinggemma2.Accelerator, id, selector string) error {
+	device := acc.(embeddinggemma2.AttachedDeviceReporter).AttachedDevice()
+	handle := reflect.ValueOf(acc).Elem()
+	ffn := !handle.FieldByName("ffnFP16").IsZero()
+	packed := handle.FieldByName("packedAttnMode").Bool()
+	fused := !handle.FieldByName("fusions").IsNil()
+	transposed := !handle.FieldByName("combinedAttention").IsZero()
+	switch selector {
+	case "cuda":
+		if ffn || packed || fused || !transposed {
+			return fmt.Errorf("Q6 eval: expected ordinary CUDA with transposed attention")
+		}
+	case embed.CUDAFP16Selector:
+		if !ffn || !packed || !fused || transposed {
+			return fmt.Errorf("Q6 eval: expected CUDA fp16 FFN, packed attention and fusions")
+		}
+	default:
+		return fmt.Errorf("Q6 eval: unexpected selector %q", selector)
+	}
+	if device.ID != id || device.Backend != "cuda" {
+		return fmt.Errorf("Q6 eval: attached %v instead of %s", device, id)
+	}
+	path := os.Getenv("PBRAIN_Q6_EVAL_ATTACH")
+	file, err := os.OpenFile(path, os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0600)
+	if err != nil {
+		return err
+	}
+	_, err = fmt.Fprintf(file, "{\"q6_eval_attach\":{\"selector\":%q,\"uuid\":%q,\"cc_major\":%d,\"cc_minor\":%d,\"fp16_ffn\":%t,\"packed_attention\":%t,\"fusions\":%t,\"transposed_attention\":%t}}\n",
+		selector, device.ID, device.ComputeCapability.Major, device.ComputeCapability.Minor, ffn, packed, fused, transposed)
+	return errors.Join(err, file.Close())
