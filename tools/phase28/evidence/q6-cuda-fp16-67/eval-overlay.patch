+func TestQ6EvaluationLayouts(t *testing.T) {
+	dir := fixtureDir(t, "PBRAIN_TEST_GEMMA2_Q6")
+	gpu := os.Getenv("PBRAIN_Q6_EVAL_DEVICE")
+	if gpu == "" {
+		t.Fatal("set exact CUDA device UUID")
+	}
+	row := testGGUFEntry(t, q6Name)
+	reg := embed.NewRegistry(row)
+	groups := []struct {
+		name  string
+		texts []string
+	}{
+		{"59", batchFixture(t)}, {"219", q6EvalLongFixture(t)},
+	}
+	for _, precision := range []string{"fp32", "fp16"} {
+		t.Run(precision, func(t *testing.T) {
+			profile := reg.ResolveWriter(row.Model, precision, gpu)
+			if precision == "fp16" && (profile.Selector != embed.CUDAFP16Selector || profile.DeviceID != gpu) {
+				t.Fatalf("unexpected fp16 writer: %+v", profile)
+			}
+			if precision == "fp32" && profile.Selector != "" {
+				t.Fatalf("unexpected fp32 writer: %+v", profile)
+			}
+			x, err := reg.Open(t.Context(), verified(t, dir, row.Model), embed.OpenOptions{Device: gpu, Writer: profile})
+			if err != nil {
+				t.Fatal(err)
+			}
+			e := x.(*encoder)
+			t.Cleanup(func() {
+				if err := e.Close(); err != nil {
+					t.Error(err)
+				}
+			})
+			if e.cpu != nil || e.Info().Device != "cuda:0" || e.Fingerprint() != profile.Fingerprint || e.Info().Budget != 6<<30 {
+				t.Fatalf("unexpected named writer: info=%+v fingerprint=%s", e.Info(), e.Fingerprint())
+			}
+			for _, group := range groups {
+				t.Run(group.name, func(t *testing.T) {
+					texts := group.texts
+					get := func(in []string) [][]float32 {
+						t.Helper()
+						vs, err := e.Embed(t.Context(), embed.Document, in)
+						if err != nil || len(vs) != len(in) {
+							t.Fatalf("embed: %d vectors, %v", len(vs), err)
+						}
+						return vs
+					}
+					singles := make([][]float32, len(texts))
+					h := sha256.New()
+					bits := make([]byte, 4*dimension)
+					for i := range texts {
+						singles[i] = get(texts[i : i+1])[0]
+						for j, v := range singles[i] {
+							binary.LittleEndian.PutUint32(bits[4*j:], math.Float32bits(v))
+						}
+						h.Write(bits)
+					}
+					t.Logf("route=%s count=%d singleton_sha256=%x", precision, len(texts), h.Sum(nil))
+					check := func(label string, got [][]float32) {
+						t.Helper()
+						for i := range got {
+							if !sameVectorBits(singles[i], got[i]) {
+								t.Fatalf("%s differs from singleton at %d", label, i)
+							}
+						}
+						t.Logf("route=%s %s %d/%d equal", precision, label, len(got), len(singles))
+					}
+					check("packed", get(texts))
+					var split [][]float32
+					for block := range slices.Chunk(texts, 17) {
+						split = append(split, get(block)...)
+					}
+					check("split17", split)
+					rev := slices.Clone(texts)
+					slices.Reverse(rev)
+					got := get(rev)
+					slices.Reverse(got)
+					check("reversed", got)
+					prior := e.info.Budget
+					e.info.Budget = 1 << 20
+					defer func() { e.info.Budget = prior }()
+					check("1-MiB", get(texts))
+				})
+			}
+		})
+	}
+}
